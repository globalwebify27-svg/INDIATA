# ==============================================================================
# Rajtantra Platform — Environment Configuration Template
# Copy this file to .env and configure local development variables.
# NEVER commit real credentials or secrets to version control.
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# Database Configuration (MySQL 8.0)
DATABASE_URL="mysql://app_user:SecurePassword123@localhost:3306/election_db?connection_limit=20"
DB_HOST=localhost
DB_PORT=3306
DB_USER=app_user
DB_PASSWORD=SecurePassword123
DB_NAME=election_db
DB_ROOT_PASSWORD=RootPassword123

# Redis Configuration (Redis 7.0)
REDIS_URL="redis://:RedisAuthPass@localhost:6379/0"
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=RedisAuthPass

# S3 / MinIO Object Storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
STORAGE_DRIVER=MINIO
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=rajtantra-dev-assets
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin

# JWT Authentication Secrets (Generate secure random 64-char strings for production)
JWT_ACCESS_SECRET="rajtantra_dev_access_secret_super_secure_key_1234567890_abcdef"
JWT_REFRESH_SECRET="rajtantra_dev_refresh_secret_super_secure_key_0987654321_fedcba"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS Configuration
CORS_ORIGIN="http://localhost:3000,http://localhost:3001,http://localhost:3002"

# Web Applications Public URLs
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
