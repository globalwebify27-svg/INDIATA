{
  "name": "rajtantra",
  "version": "1.0.0",
  "private": true,
  "description": "Rajtantra — Election Management & Campaign Intelligence Platform",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "pnpm --filter @rajtantra/web build",
    "dev": "pnpm --filter @rajtantra/web dev",
    "dev:all": "turbo run dev",
    "dev:candidate": "pnpm --filter @rajtantra/web-candidate dev",
    "dev:distributor": "pnpm --filter @rajtantra/web-distributor dev",
    "dev:superadmin": "pnpm --filter @rajtantra/web-superadmin dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
