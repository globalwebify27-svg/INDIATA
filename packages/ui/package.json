{
  "name": "@rajtantra/ui",
  "version": "1.0.0",
  "private": true,
  "description": "Shared Design System & UI component library for Rajtantra",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./tokens": {
      "types": "./src/tokens/index.ts",
      "import": "./src/tokens/index.ts",
      "default": "./src/tokens/index.ts"
    },
    "./buttons": {
      "types": "./src/buttons/index.ts",
      "import": "./src/buttons/index.ts",
      "default": "./src/buttons/index.ts"
    },
    "./forms": {
      "types": "./src/forms/index.ts",
      "import": "./src/forms/index.ts",
      "default": "./src/forms/index.ts"
    },
    "./tables": {
      "types": "./src/tables/index.ts",
      "import": "./src/tables/index.ts",
      "default": "./src/tables/index.ts"
    },
    "./dialogs": {
      "types": "./src/dialogs/index.ts",
      "import": "./src/dialogs/index.ts",
      "default": "./src/dialogs/index.ts"
    },
    "./navigation": {
      "types": "./src/navigation/index.ts",
      "import": "./src/navigation/index.ts",
      "default": "./src/navigation/index.ts"
    },
    "./cards": {
      "types": "./src/cards/index.ts",
      "import": "./src/cards/index.ts",
      "default": "./src/cards/index.ts"
    },
    "./charts": {
      "types": "./src/charts/index.ts",
      "import": "./src/charts/index.ts",
      "default": "./src/charts/index.ts"
    },
    "./feedback": {
      "types": "./src/feedback/index.ts",
      "import": "./src/feedback/index.ts",
      "default": "./src/feedback/index.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "tailwind-merge": "^3.0.2"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@rajtantra/config-typescript": "workspace:*",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.2"
  }
}
