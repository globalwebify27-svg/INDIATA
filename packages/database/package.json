{
  "name": "@rajtantra/database",
  "version": "1.0.0",
  "private": true,
  "description": "Prisma ORM schema, migrations, seeds, and database client for Rajtantra",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "prisma generate && tsc",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0"
  },
  "devDependencies": {
    "@rajtantra/config-typescript": "workspace:*",
    "@types/node": "^22.13.9",
    "bcryptjs": "^3.0.2",
    "@types/bcryptjs": "^2.4.6",
    "prisma": "^5.22.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
