{
  "name": "@rajtantra/database",
  "version": "1.0.0",
  "private": true,
  "description": "Prisma ORM schema, migrations, seeds, and database client for Rajtantra",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "prisma generate && tsc",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed/index.ts",
    "seed": "tsx prisma/seed/index.ts",
    "seed:core": "tsx prisma/seed/index.ts --module=core",
    "seed:commercial": "tsx prisma/seed/index.ts --module=commercial",
    "seed:elections": "tsx prisma/seed/index.ts --module=elections",
    "seed:workforce": "tsx prisma/seed/index.ts --module=workforce",
    "seed:field": "tsx prisma/seed/index.ts --module=field-operations",
    "seed:voters": "tsx prisma/seed/index.ts --module=voters",
    "seed:engagement": "tsx prisma/seed/index.ts --module=engagement",
    "seed:audit": "tsx prisma/seed/index.ts --module=audit",
    "seed:validate": "tsx prisma/seed/index.ts --dry-run",
    "seed:list": "tsx prisma/seed/index.ts --list",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0"
  },
  "devDependencies": {
    "@rajtantra/config-typescript": "workspace:*",
    "@types/node": "^22.13.9",
    "bcryptjs": "^3.0.2",
    "@types/bcryptjs": "^2.4.6",
    "prisma": "^5.22.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
