datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// =============================================================
// ENUMS & PLATFORM PRIMITIVES
// =============================================================

enum Role {
  SUPER_ADMIN
  DISTRIBUTOR
  CANDIDATE_ADMIN
  KARYAKARTA
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_APPROVAL
}

enum OrganizationStatus {
  PENDING
  ACTIVE
  SUSPENDED
  EXPIRED
}

enum PlanType {
  TRIAL_5D
  OFFICE_6M
  OFFICE_12M
  ELECTION_MODULE
}

enum DistributorStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
  REJECTED
}

enum TransactionStatus {
  COMPLETED
  PENDING
  FAILED
  REFUNDED
}

enum PayoutStatus {
  PENDING
  APPROVED
  SETTLED
  REJECTED
}

enum EnquiryStatus {
  PENDING
  REVIEWED
  APPROVED
  REJECTED
}

enum VoterStatus {
  VERIFIED
  CORRECTION_REQ
  QUARANTINED
  PENDING_APPROVAL
}

enum VoterRecordSource {
  ECI_IMPORT
  CANDIDATE_ADMIN
  KARYAKARTA_CREATED
  PUBLIC_ENQUIRY
}

enum VoterClassification {
  SUPPORTER
  OPPONENT
  DOUBTFUL
  NEUTRAL
  UNDECIDED
}

enum TurnoutStatus {
  VOTED
  NOT_VOTED
}

enum SlipChannel {
  WHATSAPP_DIGITAL
  THERMAL_58MM
  PHYSICAL_DELIVERY
}

enum SlipStatus {
  GENERATED
  PRINTED
  DELIVERED
  FAILED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  NEW
  ASSIGNED
  IN_PROGRESS
  FOLLOW_UP
  RESOLVED
  CLOSED
}

enum CorrectionStatus {
  PENDING_WAR_ROOM
  APPROVED
  REJECTED
}

enum BroadcastScope {
  ALL_CADRE
  BOOTH_SPECIFIC
  WARD_SPECIFIC
}

// =============================================================
// MULTI-TENANCY & FRANCHISE COMMERCIAL ENTITIES
// =============================================================

model Organization {
  id                    String                 @id @default(uuid()) @db.VarChar(36)
  name                  String                 @db.VarChar(150)
  slug                  String                 @unique @db.VarChar(100)
  status                OrganizationStatus     @default(ACTIVE)
  planType              PlanType               @default(TRIAL_5D)
  hasAiMode             Boolean                @default(false)
  aiSeatsLimit          Int                    @default(0)
  state                 String                 @db.VarChar(50)
  district              String                 @db.VarChar(100)
  constituencyName      String                 @db.VarChar(150)
  electionType          String                 @db.VarChar(50)
  pollingDate           DateTime?              @db.Date
  
  distributorId         String?                @db.VarChar(36)
  distributor           Distributor?           @relation(fields: [distributorId], references: [id], onDelete: SetNull)
  
  users                 User[]
  booths                PollingBooth[]
  voters                Voter[]
  issueTickets          IssueTicket[]
  auditLogs             AuditLog[]
  transactions          DistributorTransaction[]
  surveys               VoterSurveyRecord[]
  turnoutAudits         VoterTurnoutAudit[]
  slipDispatches        VoterSlipDispatch[]
  hourlyTurnoutLogs     BoothHourlyTurnoutLog[]
  broadcasts            BroadcastNotification[]
  correctionRequests    VoterCorrectionRequest[]
  
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([status])
  @@index([distributorId])
  @@index([state, district, constituencyName])
  @@map("organizations")
}

model Distributor {
  id                    String                   @id @default(uuid()) @db.VarChar(36)
  companyName           String                   @db.VarChar(150)
  contactName           String                   @db.VarChar(100)
  email                 String                   @unique @db.VarChar(120)
  phone                 String                   @unique @db.VarChar(20)
  userId                String?                  @unique @db.VarChar(36)
  user                  User?                    @relation("DistributorUser", fields: [userId], references: [id], onDelete: SetNull)
  organizations         Organization[]
  transactions          DistributorTransaction[]
  payouts               DistributorPayout[]
  status                DistributorStatus        @default(ACTIVE)
  commissionRatePct     Decimal                  @default(20.00) @db.Decimal(5, 2)
  bankAccountName       String?                  @db.VarChar(150)
  bankAccountNumber     String?                  @db.VarChar(50)
  bankIfsc              String?                  @db.VarChar(20)
  bankName              String?                  @db.VarChar(100)
  
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  @@index([status])
  @@map("distributors")
}

model DistributorTransaction {
  id                    String             @id @default(uuid()) @db.VarChar(36)
  transactionRef        String             @unique @db.VarChar(64)
  distributorId         String             @db.VarChar(36)
  distributor           Distributor        @relation(fields: [distributorId], references: [id], onDelete: Cascade)
  organizationId        String?            @db.VarChar(36)
  organization          Organization?      @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  planType              PlanType
  grossAmount           Decimal            @db.Decimal(12, 2)
  commissionRatePct     Decimal            @db.Decimal(5, 2)
  commissionAmount      Decimal            @db.Decimal(12, 2)
  status                TransactionStatus  @default(COMPLETED)
  paymentMethod         String?            @db.VarChar(50)
  utrNumber             String?            @db.VarChar(100)
  receiptUrl            String?            @db.VarChar(255)
  settledAt             DateTime?
  
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([distributorId, status])
  @@index([organizationId])
  @@map("distributor_transactions")
}

model DistributorPayout {
  id                    String        @id @default(uuid()) @db.VarChar(36)
  payoutNumber          String        @unique @db.VarChar(32)
  distributorId         String        @db.VarChar(36)
  distributor           Distributor   @relation(fields: [distributorId], references: [id], onDelete: Cascade)
  amount                Decimal       @db.Decimal(12, 2)
  status                PayoutStatus  @default(PENDING)
  requestedAt           DateTime      @default(now())
  settledAt             DateTime?
  utrNumber             String?       @db.VarChar(100)
  remarks               String?       @db.Text
  
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([distributorId, status])
  @@map("distributor_payouts")
}

// =============================================================
// IDENTITY, RBAC & SECURITY
// =============================================================

model User {
  id                    String                 @id @default(uuid()) @db.VarChar(36)
  email                 String?                @unique @db.VarChar(120)
  phone                 String                 @unique @db.VarChar(20)
  name                  String                 @db.VarChar(150)
  passwordHash          String?                @db.VarChar(255)
  role                  Role                   @default(KARYAKARTA)
  status                UserStatus             @default(ACTIVE)
  
  organizationId        String?                @db.VarChar(36)
  organization          Organization?          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  distributorProfile    Distributor?           @relation("DistributorUser")
  hasAiSeat             Boolean                @default(false)
  activationKey         String?                @unique @db.VarChar(6)
  reactivationKey       String?                @db.VarChar(12)
  deviceUuid            String?                @db.VarChar(128)
  twoFactorSecret       String?                @db.VarChar(128)
  isTwoFactorEnabled    Boolean                @default(false)
  twoFactorBackupCodes  String?                @db.Text
  lastLoginAt           DateTime?
  
  assignedBooths        String?                @db.Text // JSON or comma-separated booth numbers e.g. "101,102"
  
  refreshTokens         RefreshToken[]
  userRoles             UserRole[]
  portalAssignments     PortalAssignment[]
  sessions              UserSession[]
  auditLogs             AuditLog[]
  assignedVoters        Voter[]                @relation("KaryakartaVoters")
  createdVoters         Voter[]                @relation("CreatedVoters")
  karyakartaTickets     IssueTicket[]          @relation("KaryakartaTickets")
  surveysConducted      VoterSurveyRecord[]
  turnoutsLogged        VoterTurnoutAudit[]
  slipsDispatched       VoterSlipDispatch[]
  correctionProposals   VoterCorrectionRequest[]
  broadcastsSent        BroadcastNotification[]
  
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([organizationId, role])
  @@index([phone])
  @@map("users")
}

model RoleDefinition {
  id          String           @id @default(uuid()) @db.VarChar(36)
  code        String           @unique @db.VarChar(50)
  name        String           @db.VarChar(100)
  description String?          @db.VarChar(255)
  isSystem    Boolean          @default(false)
  userRoles   UserRole[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.VarChar(36)
  code        String           @unique @db.VarChar(100)
  domain      String           @db.VarChar(50)
  description String?          @db.VarChar(255)
  roles       RolePermission[]
  createdAt   DateTime         @default(now())

  @@index([domain])
  @@map("permissions")
}

model UserRole {
  userId     String         @db.VarChar(36)
  roleId     String         @db.VarChar(36)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       RoleDefinition @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedAt DateTime       @default(now())

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String         @db.VarChar(36)
  permissionId String         @db.VarChar(36)
  role         RoleDefinition @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission     @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Portal {
  id          String             @id @default(uuid()) @db.VarChar(36)
  key         String             @unique @db.VarChar(50)
  name        String             @db.VarChar(100)
  description String?            @db.VarChar(255)
  baseUrl     String             @db.VarChar(255)
  assignments PortalAssignment[]
  createdAt   DateTime           @default(now())

  @@map("portals")
}

model PortalAssignment {
  userId    String   @db.VarChar(36)
  portalId  String   @db.VarChar(36)
  isDefault Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  portal    Portal   @relation(fields: [portalId], references: [id], onDelete: Cascade)

  @@id([userId, portalId])
  @@map("portal_assignments")
}

model UserSession {
  id           String    @id @default(uuid()) @db.VarChar(36)
  userId       String    @db.VarChar(36)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String    @unique @db.VarChar(64)
  deviceUuid   String?   @db.VarChar(128)
  userAgent    String?   @db.VarChar(255)
  ipAddress    String?   @db.VarChar(45)
  isRevoked    Boolean   @default(false)
  lastActiveAt DateTime  @default(now())
  expiresAt    DateTime
  createdAt    DateTime  @default(now())

  @@index([userId, isRevoked])
  @@map("user_sessions")
}

model LoginAttempt {
  id         String   @id @default(uuid()) @db.VarChar(36)
  identifier String   @db.VarChar(120)
  ipAddress  String   @db.VarChar(45)
  isSuccess  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([identifier, createdAt])
  @@index([ipAddress, createdAt])
  @@map("login_attempts")
}

model AuditLog {
  id             String        @id @default(uuid()) @db.VarChar(36)
  userId         String?       @db.VarChar(36)
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  organizationId String?       @db.VarChar(36)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  action         String        @db.VarChar(100)
  resource       String        @db.VarChar(100)
  resourceId     String?       @db.VarChar(36)
  diff           String?       @db.Text
  ipAddress      String?       @db.VarChar(45)
  createdAt      DateTime      @default(now())

  @@index([organizationId])
  @@index([userId])
  @@map("audit_logs")
}

model RefreshToken {
  id         String   @id @default(uuid()) @db.VarChar(36)
  tokenHash  String   @unique @db.VarChar(64)
  userId     String   @db.VarChar(36)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceInfo String?  @db.VarChar(255)
  ipAddress  String?  @db.VarChar(45)
  isRevoked  Boolean  @default(false)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([userId, isRevoked])
  @@map("refresh_tokens")
}

model RegistrationEnquiry {
  id                    String        @id @default(uuid()) @db.VarChar(36)
  enquiryNumber         String        @unique @db.VarChar(32)
  fullName              String        @db.VarChar(150)
  mobile                String        @db.VarChar(20)
  email                 String?       @db.VarChar(120)
  passwordHash          String        @db.VarChar(255)
  candidateName         String        @db.VarChar(150)
  candidateContact      String        @db.VarChar(20)
  candidateType         String        @db.VarChar(50)
  partyName             String        @db.VarChar(150)
  electionType          String        @db.VarChar(50)
  state                 String        @db.VarChar(50)
  district              String        @db.VarChar(100)
  constituencyName      String        @db.VarChar(150)
  subDivision           String?       @db.VarChar(150)
  boothsCount           Int?          @default(0)
  electionName          String?       @db.VarChar(150)
  electionYear          Int?
  pollingDate           DateTime?     @db.Date
  requestedServices     String?       @db.Text
  notes                 String?       @db.Text
  status                EnquiryStatus @default(PENDING)
  rejectionReason       String?       @db.Text
  createdOrganizationId String?       @db.VarChar(36)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([mobile])
  @@index([status])
  @@map("registration_enquiries")
}

// =============================================================
// POLLING BOOTH & GROUND INFRASTRUCTURE
// =============================================================

model PollingBooth {
  id                      String                  @id @default(uuid()) @db.VarChar(36)
  boothNumber             String                  @db.VarChar(50)
  boothName               String                  @db.VarChar(200)
  locality                String?                 @db.VarChar(150)
  partNumber              String?                 @db.VarChar(50)
  pollingCentre           String?                 @db.VarChar(200)
  pollingAddress          String?                 @db.Text
  latitude                Decimal?                @db.Decimal(10, 7)
  longitude               Decimal?                @db.Decimal(10, 7)
  googleMapsUrl           String?                 @db.VarChar(255)
  totalVoters             Int                     @default(0)
  maleVoters              Int                     @default(0)
  femaleVoters            Int                     @default(0)
  bloName                 String?                 @db.VarChar(100)
  bloPhone                String?                 @db.VarChar(20)
  karyakartasCount        Int                     @default(0)
  slipsPercent            Int                     @default(0)
  projectedTurnout        Decimal?                @db.Decimal(5, 2)
  lastTurnout             Decimal?                @db.Decimal(5, 2)
  
  organizationId          String                  @db.VarChar(36)
  organization            Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  voters                  Voter[]
  hourlyLogs              BoothHourlyTurnoutLog[]
  
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  @@unique([organizationId, boothNumber])
  @@index([organizationId, boothNumber])
  @@map("polling_booths")
}

// =============================================================
// CENTRAL ELECTORAL REGISTRY & CITIZEN INTELLIGENCE (9 FACETS)
// =============================================================

model Voter {
  id                   String                 @id @default(uuid()) @db.VarChar(36)
  
  // 1. Identity & ECI Roll
  epicId               String?                @db.VarChar(20)
  serialNumber         Int?
  name                 String                 @db.VarChar(150)
  marathiName          String?                @db.VarChar(150)
  relativeName         String?                @db.VarChar(150)
  relation             String?                @db.VarChar(20)
  hasPhoto             Boolean                @default(false)
  photoUrl             String?                @db.VarChar(255)
  
  // 2. Demographic Profile
  age                  Int?
  gender               String?                @db.VarChar(10)
  dob                  String?                @db.VarChar(20)
  
  // 3. Contact Details
  phone                String?                @db.VarChar(20)
  whatsapp             String?                @db.VarChar(20)
  email                String?                @db.VarChar(120)
  isPhoneVerified      Boolean                @default(false)
  
  // 4. Residence & Locus (Structural Address & Telemetry)
  houseNo              String?                @db.VarChar(100)
  buildingChawl        String?                @db.VarChar(150)
  street               String?                @db.VarChar(150)
  area                 String?                @db.VarChar(150)
  landmark             String?                @db.VarChar(150)
  address              String?                @db.Text
  village              String?                @db.VarChar(100)
  ward                 String?                @db.VarChar(50)
  prabhaag             String?                @db.VarChar(50)
  pincode              String?                @db.VarChar(10)
  latitude             Decimal?               @db.Decimal(10, 7)
  longitude            Decimal?               @db.Decimal(10, 7)
  gpsAccuracy          Decimal?               @db.Decimal(5, 2)
  
  // 5. Sociological & Community
  caste                String?                @db.VarChar(100)
  subCaste             String?                @db.VarChar(100)
  communityGroup       String?                @db.VarChar(100)
  primaryLanguage      String?                @default("Marathi") @db.VarChar(50)
  occupation           String?                @db.VarChar(100)
  qualification        String?                @db.VarChar(100)
  
  // 6. Political Stance & Alignment
  classification       VoterClassification    @default(NEUTRAL)
  isKeyInfluencer      Boolean                @default(false)
  isImportant          Boolean                @default(false)
  isFavourite          Boolean                @default(false)
  votingLikelihoodPct  Int?                   @default(80)
  strategyNotes        String?                @db.Text
  remarks              String?                @db.Text
  
  // 7. Household / Family Hierarchy
  familyId             String?                @db.VarChar(50)
  familyHead           Boolean                @default(false)
  familyMembersCount   Int                    @default(1)
  
  // 8. Doorstep Visit & Welfare
  isVisited            Boolean                @default(false)
  lastVisitDate        String?                @db.VarChar(50)
  scheme               String?                @db.VarChar(200)
  demand               String?                @db.Text
  candidateHelp        String?                @db.Text
  
  // 9. Polling Day Turnout (LPIANE)
  isVoted              Boolean                @default(false)
  votedAt              String?                @db.VarChar(50)
  votedBy              String?                @db.VarChar(100)
  
  // Status Flags & Scoping
  isOutside            Boolean                @default(false)
  isDeceased           Boolean                @default(false)
  status               VoterStatus            @default(VERIFIED)
  source               VoterRecordSource      @default(KARYAKARTA_CREATED)
  
  boothId              String?                @db.VarChar(36)
  booth                PollingBooth?          @relation(fields: [boothId], references: [id], onDelete: SetNull)
  boothNumber          String?                @db.VarChar(50)
  boothName            String?                @db.VarChar(200)
  electoralPart        String?                @db.VarChar(50)
  
  organizationId       String                 @db.VarChar(36)
  organization         Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  assignedKaryakartaId String?                @db.VarChar(36)
  assignedKaryakarta   User?                  @relation("KaryakartaVoters", fields: [assignedKaryakartaId], references: [id], onDelete: SetNull)
  
  createdById          String?                @db.VarChar(36)
  createdBy            User?                  @relation("CreatedVoters", fields: [createdById], references: [id], onDelete: SetNull)

  tickets              IssueTicket[]
  surveys              VoterSurveyRecord[]
  turnoutAudits        VoterTurnoutAudit[]
  slipDispatches       VoterSlipDispatch[]
  correctionRequests   VoterCorrectionRequest[]

  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@index([organizationId, boothNumber])
  @@index([organizationId, epicId])
  @@index([organizationId, phone])
  @@index([organizationId, classification])
  @@index([organizationId, familyId])
  @@index([organizationId, isVoted])
  @@map("voters")
}

// =============================================================
// DOORSTEP SURVEYS & FIELD FEEDBACK
// =============================================================

model VoterSurveyRecord {
  id              String        @id @default(uuid()) @db.VarChar(36)
  voterId         String        @db.VarChar(36)
  voter           Voter         @relation(fields: [voterId], references: [id], onDelete: Cascade)
  karyakartaId    String?       @db.VarChar(36)
  karyakarta      User?         @relation(fields: [karyakartaId], references: [id], onDelete: SetNull)
  
  welfareScheme   String?       @db.VarChar(200)
  feedbackNotes   String?       @db.Text
  citizenDemands  String?       @db.Text
  gpsLat          Decimal?      @db.Decimal(10, 7)
  gpsLng          Decimal?      @db.Decimal(10, 7)
  isGeotagged     Boolean       @default(false)
  
  organizationId  String        @db.VarChar(36)
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime      @default(now())

  @@index([organizationId, voterId])
  @@index([karyakartaId])
  @@map("voter_surveys")
}

// =============================================================
// LIVE POLLING TURNOUT & AUDIT LEDGER (LPIANE)
// =============================================================

model VoterTurnoutAudit {
  id              String         @id @default(uuid()) @db.VarChar(36)
  voterId         String         @db.VarChar(36)
  voter           Voter          @relation(fields: [voterId], references: [id], onDelete: Cascade)
  boothNumber     String         @db.VarChar(50)
  status          TurnoutStatus
  actingUserId    String?        @db.VarChar(36)
  actingUser      User?          @relation(fields: [actingUserId], references: [id], onDelete: SetNull)
  actingUserName  String         @db.VarChar(150)
  timestamp       String         @db.VarChar(50)
  reason          String?        @db.VarChar(255)
  
  organizationId  String         @db.VarChar(36)
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime       @default(now())

  @@index([organizationId, boothNumber])
  @@index([voterId])
  @@map("voter_turnout_audits")
}

model BoothHourlyTurnoutLog {
  id              String        @id @default(uuid()) @db.VarChar(36)
  boothId         String        @db.VarChar(36)
  booth           PollingBooth  @relation(fields: [boothId], references: [id], onDelete: Cascade)
  boothNumber     String        @db.VarChar(50)
  timeSlot        String        @db.VarChar(50) // e.g. "07:00 - 09:00"
  maleVoted       Int           @default(0)
  femaleVoted     Int           @default(0)
  totalVoted      Int           @default(0)
  cumulativePct   Decimal       @db.Decimal(5, 2)
  
  organizationId  String        @db.VarChar(36)
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  recordedAt      DateTime      @default(now())

  @@index([organizationId, boothNumber])
  @@map("booth_hourly_turnout_logs")
}

// =============================================================
// ECI VOTER SLIP DISPATCH LEDGER
// =============================================================

model VoterSlipDispatch {
  id              String        @id @default(uuid()) @db.VarChar(36)
  voterId         String        @db.VarChar(36)
  voter           Voter         @relation(fields: [voterId], references: [id], onDelete: Cascade)
  channel         SlipChannel
  status          SlipStatus    @default(GENERATED)
  dispatchedById  String?       @db.VarChar(36)
  dispatchedBy    User?         @relation(fields: [dispatchedById], references: [id], onDelete: SetNull)
  dispatchedAt    DateTime      @default(now())
  
  organizationId  String        @db.VarChar(36)
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, voterId])
  @@map("voter_slip_dispatches")
}

// =============================================================
// CIVIC GRIEVANCES & ISSUE TICKETS
// =============================================================

model IssueTicket {
  id              String         @id @default(uuid()) @db.VarChar(36)
  ticketNumber    String         @unique @db.VarChar(32)
  voterId         String?        @db.VarChar(36)
  voter           Voter?         @relation(fields: [voterId], references: [id], onDelete: SetNull)
  voterName       String?        @db.VarChar(150)
  voterPhone      String?        @db.VarChar(20)
  voterBooth      String?        @db.VarChar(50)
  category        String         @db.VarChar(100)
  title           String?        @db.VarChar(255)
  description     String         @db.Text
  priority        TicketPriority @default(MEDIUM)
  status          TicketStatus   @default(NEW)
  location        String?        @db.VarChar(255)
  assignedTo      String?        @db.VarChar(150)
  resolutionNotes String?        @db.Text
  attachments     String?        @db.Text
  
  organizationId  String         @db.VarChar(36)
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  karyakartaId    String?        @db.VarChar(36)
  karyakarta      User?          @relation("KaryakartaTickets", fields: [karyakartaId], references: [id], onDelete: SetNull)
  karyakartaName  String?        @db.VarChar(150)

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([organizationId])
  @@index([voterId])
  @@index([karyakartaId])
  @@index([status])
  @@map("issue_tickets")
}

// =============================================================
// QUARANTINE CORRECTIONS & PROPOSALS
// =============================================================

model VoterCorrectionRequest {
  id                String            @id @default(uuid()) @db.VarChar(36)
  voterId           String            @db.VarChar(36)
  voter             Voter             @relation(fields: [voterId], references: [id], onDelete: Cascade)
  karyakartaId      String?           @db.VarChar(36)
  karyakarta        User?             @relation(fields: [karyakartaId], references: [id], onDelete: SetNull)
  proposedDataJson  String            @db.Text
  reason            String            @db.Text
  status            CorrectionStatus  @default(PENDING_WAR_ROOM)
  reviewedById      String?           @db.VarChar(36)
  reviewedAt        DateTime?
  
  organizationId    String            @db.VarChar(36)
  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([organizationId, status])
  @@map("voter_correction_requests")
}

// =============================================================
// BROADCAST NOTIFICATIONS & ALERTS
// =============================================================

model BroadcastNotification {
  id                String          @id @default(uuid()) @db.VarChar(36)
  organizationId    String          @db.VarChar(36)
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  senderId          String?         @db.VarChar(36)
  sender            User?           @relation(fields: [senderId], references: [id], onDelete: SetNull)
  
  title             String          @db.VarChar(200)
  message           String          @db.Text
  scope             BroadcastScope  @default(ALL_CADRE)
  targetBoothNumber String?         @db.VarChar(50)
  priority          String          @default("NORMAL") @db.VarChar(20)
  sentAt            DateTime        @default(now())

  @@index([organizationId, scope])
  @@map("broadcast_notifications")
}
